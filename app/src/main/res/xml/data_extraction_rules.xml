<?xml version="1.0" encoding="utf-8"?>
<!--
    The DataStore holds this handset's enrollment: its device id and its token,
    encrypted with an AndroidKeyStore key. The key is never part of a backup, so
    a restored token is ciphertext nothing can open, and a restored device id
    would have a second phone claim the first one's identity. Both stay on the
    device they were issued to; a restored or transferred install enrolls again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
